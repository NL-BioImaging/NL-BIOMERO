{
  "UPLOADER": {
    "enabled": true,
    "upload_to_group_folder": true,
    "chunk_size": 1
  },
  "FILE_OR_EXTENSION_PATTERNS_EXCLUSIVE": [
    "experiment.db",
    ".xlef",
    ".icarch"
  ],
  "UPLOADER_NESTED_FILE_EXTENSIONS": [
    ".lif",
    ".lof"
  ],
  "PREPROCESSING_EXTENSION_MAP": {
    ".lif": "dataset_leica_uuid",
    ".xlef": "dataset_leica_uuid",
    ".lof": "dataset_leica_uuid",
    ".db": "screen_db",
    ".icarch": "incucyte_archive"
  },
  "PREPROCESSING_CONFIG": {
    "screen_db": {
      "container": "cellularimagingcf/biomero-converter:0.2.1"
    },
    "dataset_leica_uuid": {
      "container": "cellularimagingcf/biomero-converter:0.2.1",
      "extra_params": {
        "image_uuid": "{UUID}",
        "outputformat": "omezarr04"
      }
    },
    "incucyte_archive": {
      "container": "cellularimagingcf/biomero-converter:0.2.1"
    }
  },
  "group_mappings": {
    "0": {
      "folder": "Project B",
      "groupName": "system"
    },
    "3": {
      "folder": "Project A",
      "groupName": "test"
    }
  }
}