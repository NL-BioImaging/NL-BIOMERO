{
  "UPLOADER": {
    "enabled": true,
    "upload_to_group_folder": true
  },
  "FILE_OR_EXTENSION_PATTERNS_EXCLUSIVE": [
    "experiment.db",
    ".xlef"
  ],
  "UPLOADER_NESTED_FILE_EXTENSIONS": [
    ".lif",
    ".lof"
  ],
  "PREPROCESSING_EXTENSION_MAP": {
    ".lif": "dataset_leica_uuid",
    ".xlef": "dataset_leica_uuid",
    ".lof": "dataset_leica_uuid",
    ".db": "screen_db"
  },
  "PREPROCESSING_CONFIG": {
    "screen_db": {
      "container": "cellularimagingcf/biomero-converter:latest"
    },
    "screen_db_to_tiff": {
      "container": "cellularimagingcf/cimagexpresstoometiff:v0.7",
      "extra_params": {
        "saveoption": "single"
      }
    },
    "dataset_leica_uuid": {
      "container": "cellularimagingcf/convertleica-docker:v1.5.0",
      "extra_params": {
        "image_uuid": "{UUID}"
      }
    }
  }
}