# Shared deployment settings.
#
# Keep internet-facing credentials out of this section; those live encrypted in
# .env.secrets and are rendered into local .env when deploying.

NL_BIOMERO_VERSION=1.5.0
BIOMERO_IMPORTER_VERSION=1.2.1
BIOMERO_VERSION=v2.5.3
OMERO_ZARR_PIXEL_BUFFER_VERSION=0.6.1
OMERO_FORMS_VERSION=2.2.0
OMERO_BIOMERO_VERSION=1.3.2

SPIDER_USER=surfadvisors-sloev
SPIDER_PROJECT=surfadvisors
OMERO_CSRF_TRUSTED_ORIGINS=["https://biomerodev.sda-development.src.surf-hosted.nl"]

# Public URLs and dashboard IDs.
METABASE_SITE_URL=https://biomerodev.sda-development.src.surf-hosted.nl/metabase
METABASE_IMPORTS_DB_PAGE_DASHBOARD_ID=6
METABASE_WORKFLOWS_DB_PAGE_DASHBOARD_ID=2

# Enables the BIOMERO.importer frontend in OMERO.biomero.
IMPORTER_ENABLED=TRUE
COMPOSE_PROFILES=IMPORTER_ENABLED
# To disable the BIOMERO.importer service, comment the above line and uncomment:
# IMPORTER_ENABLED=FALSE
# COMPOSE_PROFILES=adi_disabled

# Enables the BIOMERO.analyzer frontend in OMERO.biomero.
ANALYZER_ENABLED=TRUE
# To disable the BIOMERO.analyzer service, comment the above line and uncomment:
# ANALYZER_ENABLED=FALSE
# COMPOSE_PROFILES=biomero_disabled

# Internal database settings. These are not directly exposed by the public
# nginx/OMERO/Metabase surfaces in this deployment.
POSTGRES_USER=omero
POSTGRES_PASSWORD=omero
POSTGRES_DB=omero

BIOMERO_POSTGRES_USER=biomero
BIOMERO_POSTGRES_PASSWORD=biomero
BIOMERO_POSTGRES_DB=biomero

# OMERO timeout and logging settings.
OMERO_SCRIPTS_TIMEOUT=604800000
OMERO_SESSIONS_TIMEOUT=604800000
OMERO_WEB_SESSION_EXPIRE_AT_BROWSER_CLOSE=false
OMERO_WEB_SESSION_COOKIE_AGE=604800
OMERO_LOGGING_LEVEL=10

# Keep BIOMERO's Slurm accounting query narrow enough for shared clusters.
BIOMERO_SACCT_START_TIME=today

# GPU-native workflows run on Spider's GPU partition and request a GPU.
# CPU-only workflows omit --partition and use Spider's normal/default partition.
BIOMERO_GPU_PARTITION=gpu_a100_22c
BIOMERO_GPUS=1
BIOMERO_FORCE_GPU_WORKFLOWS=cellpose,stardist,stardist5d,fractal-cellpose-sam-biaflows,deconvolve_plate
BIOMERO_PULL_CPUS=8
BIOMERO_PULL_MEM=32G

# OMERO web settings.
OMERO_WEB_ENV=TEST
IMPORT_MOUNT_PATH=/data

# OMERO importer settings.
OMERO_IMPORTER_USER=root
OMERO_PORT=4064
ADI_RUN_MIGRATIONS=1
OMERO_CONTAINER_USER=1000:1000
