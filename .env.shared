# Shared deployment settings.
#
# Keep internet-facing credentials out of this section; those live encrypted in
# .env.secrets and are rendered into local .env when deploying.

# Workshop/production pull target. NL_BIOMERO_VERSION selects the prebuilt
# cellularimagingcf/* image tags (docker-compose-from-dockerhub.yml). 1.7.0 is the
# first NL-BIOMERO release that bundles every previously-patched subcomponent:
# the surf-incorporated BIOMERO release, OMERO.biomero v1.5.0 (proxied-Metabase
# link fix), and the bundled importer. With these images NO runtime patch is
# applied; former patch behavior is enabled via the BIOMERO_* env vars below.
NL_BIOMERO_VERSION=1.7.0
BIOMERO_IMPORTER_VERSION=1.2.1
# BIOMERO Python lib baked into the worker/web images. Use the surf-branch
# release that upstreamed all patched behaviors (env-file submission,
# inject_gpu_flag, shared GPU defaults, sbatch image pulls, apptainer tmp/cache,
# and slurm_default_partition); v2.8.0 is the expected version. This is for the
# locally-built compose; the pull images already bundle it.
BIOMERO_VERSION=v2.8.0
OMERO_ZARR_PIXEL_BUFFER_VERSION=0.6.1
OMERO_FORMS_VERSION=2.2.0
# OMERO.biomero release containing the proxied-Metabase link fix (surf branch),
# so the web image no longer needs patch_biomero_web_runtime.py.
OMERO_BIOMERO_VERSION=1.5.0

SPIDER_USER=biomero-sloev
SPIDER_PROJECT=biomero
OMERO_CSRF_TRUSTED_ORIGINS=["https://biomerodev.sda-development.src.surf-hosted.nl"]

# Public URLs and dashboard IDs.
METABASE_SITE_URL=https://biomerodev.sda-development.src.surf-hosted.nl/metabase
OBSERVABILITY_ROOT_URL=https://biomerodev.sda-development.src.surf-hosted.nl/logs/
METABASE_IMPORTS_DB_PAGE_DASHBOARD_ID=6
METABASE_WORKFLOWS_DB_PAGE_DASHBOARD_ID=2

# Enables the BIOMERO.importer frontend in OMERO.biomero.
IMPORTER_ENABLED=TRUE
COMPOSE_PROFILES=IMPORTER_ENABLED
# To disable the BIOMERO.importer service, comment the above line and uncomment:
# IMPORTER_ENABLED=FALSE
# COMPOSE_PROFILES=adi_disabled

# Enables the BIOMERO.analyzer frontend in OMERO.biomero.
ANALYZER_ENABLED=TRUE
# To disable the BIOMERO.analyzer service, comment the above line and uncomment:
# ANALYZER_ENABLED=FALSE
# COMPOSE_PROFILES=biomero_disabled

# Internal database settings. These are not directly exposed by the public
# nginx/OMERO/Metabase surfaces in this deployment.
POSTGRES_USER=omero
POSTGRES_PASSWORD=omero
POSTGRES_DB=omero

BIOMERO_POSTGRES_USER=biomero
BIOMERO_POSTGRES_PASSWORD=biomero
BIOMERO_POSTGRES_DB=biomero

# OMERO timeout and logging settings.
OMERO_SCRIPTS_TIMEOUT=604800000
OMERO_SESSIONS_TIMEOUT=604800000
OMERO_WEB_SESSION_EXPIRE_AT_BROWSER_CLOSE=false
OMERO_WEB_SESSION_COOKIE_AGE=604800
OMERO_LOGGING_LEVEL=10

# Keep BIOMERO's Slurm accounting query narrow enough for shared clusters.
BIOMERO_SACCT_START_TIME=today

# -------------------------------------------------------------------------
# BIOMERO core opt-in features
# -------------------------------------------------------------------------
# These were previously provided by biomeroworker/patch_biomero_runtime.py and
# are now upstreamed BIOMERO config options. They use the standard precedence
# (code default -> slurm-config.ini -> environment) and are forwarded into the
# OMERO script subprocesses by biomeroworker/processor.py (any BIOMERO_* var).

# Write a per-job environment file and have generated job scripts source it, for
# Slurm clusters that do not propagate ambient SSH shell env into sbatch jobs.
BIOMERO_ENV_FILE_SUBMISSION=true

# Set GPU_FLAG (--nv) per job from the effective use_gpu value instead of always
# passing --nv; CPU-only jobs then run without --nv.
BIOMERO_INJECT_GPU_FLAG=true

# Submit Singularity image pulls/builds as bounded Slurm jobs (instead of
# backgrounded login-node pulls). Apptainer tmp/cache dirs are set in
# slurm-config.ini ([SLURM] apptainer_tmpdir / apptainer_cachedir).
BIOMERO_IMAGE_PULL_VIA_SBATCH=true
BIOMERO_PULL_CPUS=8
BIOMERO_PULL_MEM=32G

# Shared GPU sbatch defaults applied to workflows that request GPU (a per-run
# use_gpu, or a per-workflow <name>_use_gpu=true in slurm-config.ini). Per-workflow
# GPU resources can instead be set with <name>_job_partition / <name>_job_gres /
# <name>_job_gpus keys in the [MODELS] section of slurm-config.ini.
# Leave blank to inherit Spider's defaults. Set gres OR gpus, not both.
BIOMERO_GPU_PARTITION=
BIOMERO_GPU_GRES=
BIOMERO_GPU_GPUS=

# Generic fallback partition appended to workflow jobs that have no explicit
# --partition (per-workflow or GPU). Per-workflow and GPU partitions take
# precedence over this fallback.
BIOMERO_DEFAULT_PARTITION=gpu_a100_mig

# OMERO web settings.
OMERO_WEB_ENV=TEST
IMPORT_MOUNT_PATH=/data

# OMERO importer settings.
OMERO_IMPORTER_USER=root
OMERO_IMPORTER_PASSWORD=omero
OMERO_PORT=4064
ADI_RUN_MIGRATIONS=1
OMERO_CONTAINER_USER=1000:1000
