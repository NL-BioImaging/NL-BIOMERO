NL_BIOMERO_VERSION=1.7.0-beta.13
BIOMERO_IMPORTER_VERSION=1.3.0
BIOMERO_VERSION=2.8.0-beta.3
OMERO_ZARR_PIXEL_BUFFER_VERSION=0.6.1
OMERO_FORMS_VERSION=2.2.0
OMERO_BIOMERO_VERSION=1.5.0b13

# Enables the BIOMERO.importer frontend in OMERO.biomero
IMPORTER_ENABLED=TRUE
COMPOSE_PROFILES=IMPORTER_ENABLED
# To disable the BIOMERO.importer service, comment the above line and uncomment the following:
# IMPORTER_ENABLED=FALSE
# COMPOSE_PROFILES=adi_disabled

# Enables the BIOMERO.analyzer frontend in OMERO.biomero
ANALYZER_ENABLED=TRUE
# To disable the BIOMERO.analyzer service, comment the above line and uncomment the following:
# ANALYZER_ENABLED=FALSE
# COMPOSE_PROFILES=biomero_disabled

FORMS_MASTER_USER=formsadmin5
FORMS_MASTER_PASSWORD=changedpwagain3 # TODO: placeholder, change me

# Shared host volume paths (or docker volumes) for persistent data storage
INPLACE_STORAGE_HOST_PATH=./web/L-Drive
LOGS_HOST_PATH=./logs
SSH_HOST_PATH=~/.ssh
GROUP_MAPPINGS_HOST_PATH=./web/group-mappings.json
METABASE_DATA_HOST_PATH=./metabase
SLURM_CONFIG_HOST_PATH=./web/slurm-config.ini
BIOMERO_CONFIG_HOST_PATH=./web/biomero-config.json
BIOMERO_IMPORTER_CONFIG_HOST_PATH=./config/biomero-importer
OMERO_DATA_PATH=omero # docker volume! Could also map to host volume


# Postgres Database settings
POSTGRES_USER=omero
POSTGRES_PASSWORD=omero # TODO: placeholder, change me
POSTGRES_DB=omero

POSTGRES_DATA_LOCATION=/var/lib/postgresql/data

BIOMERO_POSTGRES_USER=biomero
BIOMERO_POSTGRES_PASSWORD=biomero # TODO: placeholder, change me
BIOMERO_POSTGRES_DB=biomero

# OMERO server settings
OMERO_SERVER_DATA_LOCATION=/OMERO
OMERO_ROOT_PASSWORD=omero # TODO: placeholder, change me

# OMERO timeout and logging settings
OMERO_SCRIPTS_TIMEOUT=604800000
OMERO_SESSIONS_TIMEOUT=604800000
OMERO_WEB_SESSION_EXPIRE_AT_BROWSER_CLOSE=false
OMERO_WEB_SESSION_COOKIE_AGE=604800
OMERO_LOGGING_LEVEL=10
OMERO_SERVER_LOGGING_LOCATION=/opt/omero/server/OMERO.server/var/log

# OMERO web settings
OMERO_WEB_ENV=TEST
IMPORT_MOUNT_PATH=/data
UPLOADER_DESTINATION_DIR=/tus_destination
OMERO_BIOMERO_CONFIG_FILE=/opt/omero/web/OMERO.web/var/biomero-config.json
OMERO_BIOMERO_GROUP_MAPPINGS_FILE=/opt/omero/web/OMERO.web/var/group-mappings.json

# OMERO importer settings
OMERO_IMPORTER_USER=root
OMERO_PORT=4064
ADI_RUN_MIGRATIONS=1
OMERO_CONTAINER_USER=1000:1000

# BIOMERO worker settings
BIOMERO_CONFIG_LOCATION=/opt/omero/server

# Metabase settings
METABASE_USER=admin@biomero.com
METABASE_PASSWORD=b1omero  # TODO: placeholder, change me
METABASE_DATA_LOCATION=/metabase-data
METABASE_SITE_URL=http://localhost:3000
METABASE_SECRET_KEY=1f8e2c8ae6450b1035fe5ac9219a8f34702ab3cb01b1c3c767cfb55922c1d881  # TODO: placeholder, change me
METABASE_IMPORTS_DB_PAGE_DASHBOARD_ID=6
METABASE_WORKFLOWS_DB_PAGE_DASHBOARD_ID=2

